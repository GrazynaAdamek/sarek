def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test --input tests/csv/3.0/mapped_joint_bam.csv --tools deepvariant --joint_genotype --nucleotides_per_second 20",
            params: [
                genome: 'testdata.nf-core.sarek',
                igenomes_base: modules_testdata_base_path,
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                step: "variant_calling",
                tools: 'deepvariant',
                joint_genotype: true,
                wes: true,
                nucleotides_per_second: 20
            ]
        ],
        [
            name: "-profile test --input tests/csv/3.0/mapped_joint_bam.csv --tools deepvariant --joint_genotype --nucleotides_per_second 100",
            params: [
                genome: 'testdata.nf-core.sarek',
                igenomes_base: modules_testdata_base_path,
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                step: "variant_calling",
                tools: 'deepvariant',
                joint_genotype: true,
                wes: true,
                nucleotides_per_second: 100
            ]
        ]
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }

    test("--joint_genotype without --tools deepvariant emits warning and does not run joint genotyping") {

        options "-stub"

        when {
            params {
                outdir         = "$outputDir"
                input          = "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv"
                step           = 'variant_calling'
                tools          = 'haplotypecaller'
                joint_genotype = true
                wes            = true
            }
        }

        then {
            assertAll(
                // The pipeline must not error when joint_genotype is set without deepvariant,
                // so configs that default joint_genotype=true don't break runs with other tools.
                { assert workflow.success },
                // Joint genotyping must be skipped: no cohort VCF in output.
                { assert !getAllFilesFromDir(params.outdir, include: ['**/joint_variant_calling*.vcf.gz']) }
            )
        }
    }
}
