// Minimal config for tests: mirror conf/modules/deepvariant_joint_genotype.config
// so per-interval outputs get distinct names and don't clash on stage-in into
// MERGE_GLNEXUS_VCF (GATK4_MERGEVCFS).
process {
    withName: 'GLNEXUS' {
        ext.args   = '--config DeepVariant'
        ext.prefix = { meta.num_intervals <= 1 ? 'joint_variant_calling' : "joint_variant_calling.${meta.intervals_name}" }
    }
    withName: 'BCFTOOLS_VIEW' {
        ext.args   = '--output-type z'
        ext.prefix = { meta.num_intervals <= 1 ? 'joint_variant_calling' : "joint_variant_calling.${meta.intervals_name}" }
    }
    withName: 'MERGE_GLNEXUS_VCF' {
        ext.prefix = { 'joint_variant_calling' }
    }
}
