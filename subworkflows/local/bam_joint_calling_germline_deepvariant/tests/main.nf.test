nextflow_workflow {

    name "Test Subworkflow BAM_JOINT_CALLING_GERMLINE_DEEPVARIANT"
    script "../main.nf"
    workflow "BAM_JOINT_CALLING_GERMLINE_DEEPVARIANT"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "bam_joint_calling_germline_deepvariant"

    test("Should run DeepVariant joint genotyping without intervals") {

        when {
            workflow {
                """
                // Two per-sample DeepVariant gVCFs, called over the whole genome
                // (num_intervals = 1 -> no per-interval scatter, no merge).
                gvcf_tbi_intervals = Channel.of(
                    [
                        [ id:'sample1', num_intervals:1 ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz.tbi', checkIfExists: true),
                        []
                    ],
                    [
                        [ id:'sample2', num_intervals:1 ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz.tbi', checkIfExists: true),
                        []
                    ]
                )
                dict = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                ])

                input[0] = gvcf_tbi_intervals
                input[1] = dict
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Use variantsMD5 (content hash ignoring headers) because BCFTOOLS_VIEW
                // writes a Date= line into the VCF header, making raw file md5 non-deterministic.
                // Snapshot only the index filename (not its md5) for the same reason.
                { assert snapshot(
                    workflow.out.genotype_vcf.collect { meta, vcf -> [ meta, path(vcf).vcf.variantsMD5 ] },
                    workflow.out.genotype_index.collect { meta, tbi -> [ meta, file(tbi).name ] }
                ).match() }
            )
        }
    }

    test("Should run DeepVariant joint genotyping with multiple intervals (stub)") {

        options "-stub"

        when {
            workflow {
                """
                // Same two samples, but scattered across two intervals
                // (num_intervals = 2). Each sample contributes a per-interval
                // gVCF for each interval; the subworkflow groups per interval,
                // calls GLNEXUS twice, then MERGE_GLNEXUS_VCF merges the two
                // per-interval VCFs back into one cohort VCF.
                //
                // The interval files only matter for their basename (used to
                // build meta.intervals_name, which drives grouping); their
                // content is irrelevant here. Run as -stub so the merge does
                // not depend on the (overlapping) gVCF fixtures - the real
                // multi-interval merge is validated by the pipeline-level test
                // tests/joint_calling_deepvariant.nf.test.
                gvcf      = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz', checkIfExists: true)
                gvcf_tbi  = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf.gz.tbi', checkIfExists: true)
                gvcf2     = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz', checkIfExists: true)
                gvcf2_tbi = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test2.genome.vcf.gz.tbi', checkIfExists: true)
                interval_a = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists: true)
                interval_b = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed', checkIfExists: true)

                gvcf_tbi_intervals = Channel.of(
                    [ [ id:'sample1', num_intervals:2 ], gvcf,  gvcf_tbi,  interval_a ],
                    [ [ id:'sample2', num_intervals:2 ], gvcf2, gvcf2_tbi, interval_a ],
                    [ [ id:'sample1', num_intervals:2 ], gvcf,  gvcf_tbi,  interval_b ],
                    [ [ id:'sample2', num_intervals:2 ], gvcf2, gvcf2_tbi, interval_b ]
                )
                dict = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                ])

                input[0] = gvcf_tbi_intervals
                input[1] = dict
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Structural assertions only: -stub outputs can't be content-hashed.
                // The key invariant is that intervals_name is stripped before groupTuple()
                // so both per-interval VCFs collapse into ONE merged output (not two).
                // If the groupKey stripping were broken we'd get size() == 2 here.
                { assert workflow.out.genotype_vcf.size() == 1 },
                { assert file(workflow.out.genotype_vcf[0][1]).name == "joint_variant_calling.vcf.gz" },
                { assert workflow.out.genotype_vcf[0][0] == [id:'joint_variant_calling', patient:'all_samples', variantcaller:'deepvariant'] }
            )
        }
    }
}
