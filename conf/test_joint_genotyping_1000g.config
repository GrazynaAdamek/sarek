/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for 1000 Genomes joint genotyping (DeepVariant) test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Realistic 3-sample, single-chromosome (chr20 / GRCh37 b37) end-to-end test
    that exercises DeepVariant per-sample calling → GLnexus joint genotyping →
    VEP annotation.  Data is NOT committed to the repo; run scripts/prepare_testdata_1000g_chr20.sh
    first to download and subset the 1000 Genomes phase-3 alignments.

    Prerequisites:
        bash scripts/prepare_testdata_1000g_chr20.sh     # downloads + subsets to tests/data/

    Use as follows:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test,test_joint_genotyping_1000g,docker \
            --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '30.GB',
        time: '8.h'
    ]
}

params {
    config_profile_name        = 'Joint genotyping (DeepVariant + GLnexus) 1000G test profile'
    config_profile_description = '3-sample, chr20-only 1000G end-to-end test: DeepVariant + joint genotyping + VEP (GRCh37)'

    // Input: 3 phase-3 GBR individuals subsetted to chr20 by scripts/prepare_testdata_1000g_chr20.sh
    input          = "${projectDir}/tests/csv/3.0/mapped_joint_bam_1000g.csv"
    step           = 'variant_calling'
    tools          = 'deepvariant,vep'
    joint_genotype = true

    // Reference: single-chromosome GRCh37 produced by scripts/prepare_testdata_1000g_chr20.sh
    // Disable iGenomes; supply all reference files explicitly.
    igenomes_ignore = true
    fasta           = "${projectDir}/tests/data/ref.chr20.fasta"
    fasta_fai       = "${projectDir}/tests/data/ref.chr20.fasta.fai"
    dict            = "${projectDir}/tests/data/ref.chr20.dict"

    // Restrict variant calling to chr20 only
    intervals       = "${projectDir}/tests/data/chr20.bed"

    // VEP against GRCh37; set vep_cache to a local path or use download_cache=true.
    // VEP cache must be GRCh37/b37 (same assembly as the reference above).
    vep_genome         = 'GRCh37'
    vep_species        = 'homo_sapiens'
    vep_cache_version  = 110
    // Uncomment to download the cache automatically (requires network + ~15 GB disk):
    // download_cache  = true
    // Or point to a pre-downloaded cache:
    // vep_cache       = "/path/to/vep_cache"
}
