/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for 1000 Genomes joint genotyping — full end-to-end with VEP
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    3-sample, 3-interval chr20 test exercising scatter/gather (9 DeepVariant tasks →
    per-sample merge → GLnexus joint genotyping → VEP annotation).

    Prerequisites:
        bash scripts/prepare_testdata_1000g_chr20.sh --vep /path/to/vep_cache

    Use as follows:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test,test_joint_genotyping_1000g_intervals,docker \
            --vep_cache /path/to/vep_cache \
            --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Cap to local machine capacity; base.config ideal values (12 CPU / 37 GB) are
    // used unchanged on cloud where limits are higher.
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '8.h'
    ]
}

params {
    config_profile_name        = 'Joint genotyping (DeepVariant + GLnexus) 1000G scatter/gather + VEP test profile'
    config_profile_description = '3-sample, chr20 3 × 500 kbp 1000G full end-to-end test: scatter/gather + joint genotyping + VEP (GRCh37) — requires --vep_cache'

    // Input: 3 phase-3 GBR individuals subsetted to chr20 by scripts/prepare_testdata_1000g_chr20.sh
    input          = "${projectDir}/tests/csv/3.0/mapped_joint_bam_1000g.csv"
    step           = 'variant_calling'
    tools          = 'deepvariant,vep'
    joint_genotype = true

    // Reference: single-chromosome GRCh37 produced by scripts/prepare_testdata_1000g_chr20.sh
    // Disable iGenomes; supply all reference files explicitly.
    igenomes_ignore = true
    fasta           = "${projectDir}/tests/data/ref.chr20.fasta"
    fasta_fai       = "${projectDir}/tests/data/ref.chr20.fasta.fai"
    dict            = "${projectDir}/tests/data/ref.chr20.dict"

    // 3 short intervals (500 kbp each) — triggers scatter/gather (MERGE_DEEPVARIANT_GVCF/VCF per sample).
    // nucleotides_per_second must be low enough that each interval exceeds the 600 s chunk threshold
    // in CREATE_INTERVALS_BED; at the default 200000 all three 500 kbp windows collapse into one chunk.
    intervals              = "${projectDir}/tests/data/chr20_subset.multi_intervals.bed"
    nucleotides_per_second = 200

    // Symlink published outputs to avoid duplicate copies of large VCF/gVCF files.
    publish_dir_mode   = 'symlink'

    // VEP against GRCh37. Pass --vep_cache /path/to/cache on the CLI.
    // Download once: bash scripts/prepare_testdata_1000g_chr20.sh --vep /path/to/cache
    vep_genome         = 'GRCh37'
    vep_species        = 'homo_sapiens'
    vep_cache_version  = 115
}
