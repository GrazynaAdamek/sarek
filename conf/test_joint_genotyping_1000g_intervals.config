/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for 1000 Genomes joint genotyping with scatter/gather intervals
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same 3-sample chr20 test as test_joint_genotyping_1000g, but chr20 is split into
    3 intervals so that MERGE_DEEPVARIANT_GVCF and MERGE_DEEPVARIANT_VCF are exercised.
    Data is NOT committed to the repo; run scripts/prepare_testdata_1000g_chr20.sh first.

    Prerequisites:
        bash scripts/prepare_testdata_1000g_chr20.sh     # downloads + subsets to tests/data/

    Use as follows:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test,test_joint_genotyping_1000g_intervals,docker \
            --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '14.GB',
        time: '8.h'
    ]

    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        memory = { 14.GB * task.attempt }
    }
}

params {
    config_profile_name        = 'Joint genotyping (DeepVariant + GLnexus) 1000G scatter/gather test profile'
    config_profile_description = '3-sample, chr20-only 1000G test with 3 intervals: exercises DeepVariant scatter/gather merge + joint genotyping + VEP (GRCh37)'

    // Input: 3 phase-3 GBR individuals subsetted to chr20 by scripts/prepare_testdata_1000g_chr20.sh
    input          = "${projectDir}/tests/csv/3.0/mapped_joint_bam_1000g.csv"
    step           = 'variant_calling'
    tools          = 'deepvariant,vep'
    joint_genotype = true

    // Reference: single-chromosome GRCh37 produced by scripts/prepare_testdata_1000g_chr20.sh
    // Disable iGenomes; supply all reference files explicitly.
    igenomes_ignore = true
    fasta           = "${projectDir}/tests/data/ref.chr20.fasta"
    fasta_fai       = "${projectDir}/tests/data/ref.chr20.fasta.fai"
    dict            = "${projectDir}/tests/data/ref.chr20.dict"

    // chr20 split into 3 equal intervals — triggers MERGE_DEEPVARIANT_GVCF/VCF per sample
    intervals       = "${projectDir}/tests/data/chr20.multi_intervals.bed"

    // VEP against GRCh37; cache is read from s3://annotation-cache/vep_cache/ (default).
    // VEP cache must be GRCh37/b37 (same assembly as the reference above).
    vep_genome         = 'GRCh37'
    vep_species        = 'homo_sapiens'
    vep_cache_version  = 110
}
