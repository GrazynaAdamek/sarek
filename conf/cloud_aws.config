/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for running sarek on AWS Batch with S3 storage
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Prototype cloud profile for joint genotyping at scale (~1000 WGS samples).
    See docs/intelliseq_technical_recruitment/CLOUD_SCALE_DESIGN.md for the full
    design rationale (data volume, memory, spot handling, work-dir hygiene).

    Prerequisites:
        - AWS Batch compute environment with two job queues:
            params.aws_spot_queue     (Spot instances, default)
            params.aws_ondemand_queue (On-demand instances, used on final retry)
        - Seqera Platform account (free tier) for Wave + Fusion filesystem
        - S3 bucket for work dir and outputs

    Usage:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test_joint_genotyping_1000g,cloud_aws,docker \
            -work-dir s3://your-bucket/sarek-work \
            --outdir   s3://your-bucket/sarek-results \
            --aws_spot_queue     sarek-spot-queue \
            --aws_ondemand_queue sarek-ondemand-queue \
            --aws_region         eu-west-1
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'AWS Batch cloud profile'
    config_profile_description = 'Joint genotyping at scale on AWS Batch with S3 + Fusion'

    aws_spot_queue     = 'sarek-spot-queue'
    aws_ondemand_queue = 'sarek-ondemand-queue'
    aws_region         = 'eu-west-1'
}

// Seqera Fusion: mounts S3 as a virtual filesystem so Nextflow never copies
// gVCF files locally — it issues HTTP range requests directly against S3.
// At ~5 TB total gVCFs (1000 samples × 5 GB) this avoids staging entire files
// onto instance disks. Requires a free Seqera Platform account for Wave.
fusion {
    enabled                  = true
    exportStorageCredentials = true
}

wave {
    enabled  = true
    endpoint = 'https://wave.seqera.io'
}

process {
    executor = 'awsbatch'

    // Retry on spot interruption exit codes (130=SIGINT, 137=SIGKILL, 143=SIGTERM)
    // and on transient AWS Batch failures (104=connection reset). Generic exit 1 is
    // NOT retried: it signals a real failure (bad gVCF, GLnexus bug, OOM-as-1) that
    // would otherwise burn all retries — hours each — before failing the run anyway.
    errorStrategy = { task.exitStatus in [104, 130, 137, 143] ? 'retry' : 'finish' }
    maxRetries    = 3

    // First two attempts use Spot instances; final attempt escalates to On-demand
    // to break out of a spot-capacity drought without manual intervention.
    queue = { task.attempt > 2 ? params.aws_ondemand_queue : params.aws_spot_queue }
}

aws {
    region = params.aws_region
    batch {
        cliPath   = '/usr/local/aws-cli/v2/current/bin/aws'
        logsGroup = '/aws/batch/sarek'
    }
}

// Delete intermediate work directories on successful pipeline completion.
// S3 lifecycle rules (set in AWS console / Terraform) should also expire
// objects under the work prefix after ~30 days to catch interrupted runs.
cleanup = true

process {
    // GLnexus: the memory-critical step at cohort scale.
    // With 1000 WGS samples and per-chromosome scatter (~24 intervals),
    // each job sees ~200 GB of gVCFs (via Fusion) and needs ~64 GB RAM.
    // Large chromosomes (chr1/chr2) may require the 2× retry escalation.
    // disk covers only the GLnexus.DB scratch directory, not gVCF staging.
    withName: '.*:BAM_JOINT_CALLING_GERMLINE_DEEPVARIANT:GLNEXUS' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        disk   = 100.GB
        time   = { 4.h * task.attempt }
    }

    // DeepVariant reads 20–30 GB CRAMs per sample; Fusion eliminates local
    // CRAM staging so disk requirements here are for the output gVCF only.
    withName: '.*DEEPVARIANT.*' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
