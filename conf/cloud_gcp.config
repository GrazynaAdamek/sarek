/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for running sarek on GCP Batch with GCS storage
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Prototype cloud profile for joint genotyping at scale (~1000 WGS samples).
    See docs/intelliseq_technical_recruitment/CLOUD_SCALE_DESIGN.md for the full
    design rationale (data volume, memory, spot handling, work-dir hygiene).

    Prerequisites:
        - GCP project with Batch API enabled
        - GCS bucket for work dir and outputs
        - Seqera Platform account (free tier) for Wave + Fusion filesystem

    Usage:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test_joint_genotyping_1000g,cloud_gcp,docker \
            -work-dir gs://your-bucket/sarek-work \
            --outdir   gs://your-bucket/sarek-results \
            --gcp_project your-gcp-project \
            --gcp_region  europe-west4
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'GCP Batch cloud profile'
    config_profile_description = 'Joint genotyping at scale on GCP Batch with GCS + Fusion'

    gcp_project = 'your-gcp-project'
    gcp_region  = 'europe-west4'
}

// Seqera Fusion: mounts GCS as a virtual filesystem so Nextflow never copies
// gVCF files locally — it issues HTTP range requests directly against GCS.
// At ~5 TB total gVCFs (1000 samples × 5 GB) this avoids staging entire files
// onto instance disks. Requires a free Seqera Platform account for Wave.
fusion {
    enabled                  = true
    exportStorageCredentials = true
}

wave {
    enabled  = true
    endpoint = 'https://wave.seqera.io'
}

process {
    executor = 'google-batch'

    // Retry only on preemption (exit 14 = GCP PREEMPTED; 50001 = observed Batch Spot
    // reclaim code). Generic exit 1 is NOT retried: it signals a real failure (bad gVCF,
    // GLnexus bug, OOM-as-1) that would otherwise burn all retries — hours each — before
    // failing the run anyway.
    errorStrategy = { task.exitStatus in [14, 50001] ? 'retry' : 'finish' }
    maxRetries    = 3
}

google {
    project = params.gcp_project
    region  = params.gcp_region
    batch {
        // Spot VMs (preemptible equivalent on GCP Batch). NOTE: spot is a *global*
        // setting — GCP Batch has no per-task spot directive, so there is no clean way
        // to escalate a single retry to on-demand the way AWS does with two job queues.
        // A persistent capacity drought is handled by Spot retries (maxRetries above);
        // escaping it entirely requires rerunning with `google.batch.spot = false`.
        spot = true
    }
}

// Delete intermediate work directories on successful pipeline completion.
// GCS lifecycle rules (set in GCP console / Terraform) should also expire
// objects under the work prefix after ~30 days to catch interrupted runs.
cleanup = true

process {
    // GLnexus: the memory-critical step at cohort scale.
    // With 1000 WGS samples and per-chromosome scatter (~24 intervals),
    // each job sees ~200 GB of gVCFs (via Fusion) and needs ~64 GB RAM.
    // Large chromosomes (chr1/chr2) may require the 2× retry escalation.
    // disk covers only the GLnexus.DB scratch directory, not gVCF staging.
    withName: '.*:BAM_JOINT_CALLING_GERMLINE_DEEPVARIANT:GLNEXUS' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        disk   = 100.GB
        time   = { 4.h * task.attempt }
    }

    // DeepVariant reads 20–30 GB CRAMs per sample; Fusion eliminates local
    // CRAM staging so disk requirements here are for the output gVCF only.
    withName: '.*DEEPVARIANT.*' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
