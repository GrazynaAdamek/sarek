/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running joint genotyping (DeepVariant / GLnexus) tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    3-sample mini-genome smoke test for the joint-genotyping path.
    Uses the same tiny test fixtures as `conf/test.config` — no external data required.
    VEP is deliberately excluded: the mini-genome has no VEP cache.
    For a VEP-annotated end-to-end run see conf/test_joint_genotyping_1000g.config.

    Use as follows:
        NXF_SYNTAX_PARSER=v1 nextflow run main.nf \
            -profile test,test_joint_genotyping,docker \
            --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Joint genotyping (DeepVariant + GLnexus) test profile'
    config_profile_description = '3-sample mini-genome end-to-end test for --tools deepvariant --joint_genotype'

    // Re-uses the same 2-sample joint BAM fixture as the existing pipeline tests.
    input          = "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv"
    step           = 'variant_calling'
    tools          = 'deepvariant'
    joint_genotype = true

    // WES mode keeps GLnexus memory manageable on the mini-genome
    wes            = true

    // Use the multi-interval BED so the scatter/gather code path is exercised
    intervals      = "${params.modules_testdata_base_path}genomics/homo_sapiens/genome/genome.multi_intervals.bed"
    genome         = 'testdata.nf-core.sarek'
}
